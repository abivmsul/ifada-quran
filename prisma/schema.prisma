generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Sponsor {
  id        String        @id @default(uuid())
  name      String
  type      SponsorType
  phone     String?
  email     String?
  notes     String?
  status    SponsorStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  students  User[]
}

model User {
  id                    String       @id @default(uuid())
  authUserId            String?      @unique
  fullName              String
  email                 String       @unique
  phone                 String       @unique
  age                   Int?
  gender                Gender?
  telegramUsername      String?
  learningMode          LearningMode?
  role                  Role         @default(STUDENT)
  status                Status       @default(PENDING)
  isSponsored           Boolean      @default(false)
  sponsorId             String?
  sponsor               Sponsor?     @relation(fields: [sponsorId], references: [id])
  emergencyContactName  String?
  emergencyContactPhone String?
  address               String?
  approvedAt            DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  requestedLevels RequestedLevel[]
  studentLevels   StudentLevel[]
  lessons         Lesson[]
  attendance      Attendance[]
  notes           Note[]
}

model Level {
  id          String          @id @default(uuid())
  name        String
  trackType   TrackType
  levelOrder  Int
  description String?

  schedules   LevelSchedule[]

  requestedLevels RequestedLevel[]
  studentLevels   StudentLevel[]
}

model LevelSchedule {
  id          String       @id @default(uuid())
  levelId     String
  level       Level        @relation(fields: [levelId], references: [id], onDelete: Cascade)

  dayOfWeek   DayOfWeek
  startTime   String
  endTime     String
  mode        LearningMode
  location    String?

  requestedLevels RequestedLevel[]
  studentLevels   StudentLevel[]
}

model RequestedLevel {
  id          String       @id @default(uuid())
  studentId   String
  student     User         @relation(fields: [studentId], references: [id])

  levelId     String
  level       Level        @relation(fields: [levelId], references: [id])

  scheduleId  String?
  schedule    LevelSchedule? @relation(fields: [scheduleId], references: [id])

  trackType   TrackType
}

model StudentLevel {
  id          String       @id @default(uuid())
  studentId   String
  student     User         @relation(fields: [studentId], references: [id])

  levelId     String
  level       Level        @relation(fields: [levelId], references: [id])

  scheduleId  String?
  schedule    LevelSchedule? @relation(fields: [scheduleId], references: [id])

  trackType   TrackType
}

model Lesson {
  id          String    @id @default(uuid())

  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId   String

  trackType   TrackType

  title       String?
  content     String
  notes       String?

  // Quran-specific fields
  surah       String?
  fromAyah    Int?
  toAyah      Int?
  isRevision  Boolean   @default(false)

  // Kitab-specific fields
  kitabBook   String?
  kitabChapter String?
  topic       String?
  homework    String?

  date        DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([studentId, date])
  @@index([trackType, date])
}
model Attendance {
  id        String    @id @default(uuid())

  student   User      @relation(fields: [studentId], references: [id])
  studentId String

  status    AttendanceStatus

  date      DateTime

  createdAt DateTime @default(now())

  @@unique([studentId, date])
}

model Note {
  id        String   @id @default(uuid())

  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String

  text      String
  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum Status {
  PENDING
  ACTIVE
  REJECTED
}

enum TrackType {
  QURAN
  KITAB
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum LearningMode {
  ONLINE
  IN_PERSON
  BOTH
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum SponsorType {
  INDIVIDUAL
  ORGANIZATION
  FOUNDATION
  FAMILY
  OTHER
}

enum SponsorStatus {
  ACTIVE
  INACTIVE
}
